<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>{{ base_css }}</style>
<style>{{ brand_css }}</style>
<style>{{ style_css }}</style>
</head>
<body>
{% for slide in slides %}
<section class="slide layout-{{ slide.layout }} tone-{{ slide.tone }}{% if slide.is_first %} is-first{% endif %}{% if slide.is_last %} is-last{% endif %}" id="slide-{{ slide.index }}" data-slide="{{ slide.index }}">
{{ slide.html }}
</section>
{% endfor %}
<script>{{ page_tools }}</script>
</body>
</html>
